{
    "rust-analyzer.cargo.features": [
        "image",
        "notify",
        "fzf"
    ],
    "chat.tools.terminal.autoApprove": {
        "cargo clippy": true,
        "cargo fmt": true,
        "cargo test": true
    },
    "search.exclude": {
        "**/target": true,
        "**/.git": true
    },
    "files.watcherExclude": {
        "**/target/**": true,
        "**/.git/objects/**": true
    }
}
